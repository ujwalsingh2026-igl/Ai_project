# Copy to .env and edit. NEVER commit .env.
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Database: leave DB_NAME empty to use SQLite (easiest first run).
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# AI provider: local (Ollama default) | gemini | openai_compatible | echo (offline test)
AI_PROVIDER=local
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3.2:latest
AI_API_KEY=
AI_TIMEOUT=60

# Permissions / approvals
# Make level-2 (read-only device info) tools ask for approval first. Format: level:decision, comma separated.
# Leave empty for defaults. Level 3/4 can never auto-allow and level 5 is always blocked, whatever you write.
PERMISSION_OVERRIDES=
APPROVAL_TTL_SECONDS=300

# Production only
# SECURE_SSL_REDIRECT=true
# BEHIND_PROXY=false
