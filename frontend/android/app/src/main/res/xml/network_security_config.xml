<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Enforce HTTPS / TLS encryption by default for all remote internet connections -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Permit local development / private LAN traffic only for home Wi-Fi and loopback -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.227.244.161</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
