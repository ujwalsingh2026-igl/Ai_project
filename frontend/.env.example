# Vite Frontend Environment Variables
# Google OAuth Client ID for Google Identity Services (GIS) Web SDK
# Must match Authorized JavaScript Origins in Google Cloud Console (e.g. http://localhost:5173)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Target Backend Server URL (optional: leave empty for same origin, or configure tunnel / IP)
VITE_API_URL=
